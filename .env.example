# Copy to .env and adjust. .env is not committed.

# Real save used by the optional round-trip tests (read only).
TEST_TOGF_SAVE=saves/SaveDat000.sav

# Language for names (CLI and web editor), a file name in togf_save/locales.
DEFAULT_LANG=zh-Hant

# Web editor (togf-save serve). 127.0.0.1 = this computer only.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Logging (CLI and web editor) ---
# Console output is separate: CLI -v / -vv, and `serve` always logs to the console.
# Write a log file to LOG_DIR. Off when unset.
LOG_ENABLED=true
# Folder for log files (relative to where you run the command) and the file name.
LOG_DIR=logs
LOG_FILE_NAME=togf_save.log
# Lowest level written to the file: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL.
LOG_LEVEL=DEBUG
# Lowest level `serve` prints to the console (the CLI uses -v / -vv instead).
LOG_CONSOLE_LEVEL=INFO
# Start a new file by size ("10 MB"), interval ("1 day", "1 week") or time of day ("00:00").
LOG_ROTATION=10 MB
# Delete old files by age ("14 days") or keep a number of files ("10").
LOG_RETENTION=14 days
# Compress rotated files: zip, gz, bz2, xz, tar, tar.gz, ... Empty = no compression.
LOG_COMPRESSION=
# File line format (loguru format string).
LOG_FORMAT="{time:YYYY-MM-DD HH:mm:ss.SSS} | {level: <7} | {name}:{function}:{line} | {message}"
# Write each record as one JSON object per line instead of LOG_FORMAT.
LOG_SERIALIZE=false
# Full stack trace on errors. DIAGNOSE also prints variable values, which can include save data.
LOG_BACKTRACE=true
LOG_DIAGNOSE=false
# Write through a background queue (safe with the web server's threads).
LOG_ENQUEUE=true
