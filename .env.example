# Copy to .env and adjust. .env is not committed.

# Real save used by the optional round-trip tests (read only).
TEST_TOGF_SAVE=saves/SaveDat000.sav

# Language for names (CLI and web editor), a file name in togf_save/locales.
DEFAULT_LANG=zh-Hant

# Web editor (togf-save serve). 127.0.0.1 = this computer only.
WEB_HOST=127.0.0.1
WEB_PORT=8000
